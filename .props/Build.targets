<Project>
  <Target Name="SkipNetStandardExe" BeforeTargets="Build" Condition="'$(OutputType)' != 'Exe'">
    <PropertyGroup>
      <TargetFrameworks>$([System.Text.RegularExpressions.Regex]::Replace($(TargetFrameworks), ';?netstandard[^;]*', ''))</TargetFrameworks>
    </PropertyGroup>
  </Target>
</Project>


      <!-- $([System.String]::Join(';', 
        $('$(TargetFrameworks)'.Where(s => !s.StartsWith('netstandard'))))
      ) -->